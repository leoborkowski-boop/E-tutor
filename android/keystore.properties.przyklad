# Prywatny klucz do publikacji w Google Play. NIE wrzucaj tego pliku ani klucza do repozytorium.
# 1. Utwórz klucz (raz, zapamiętaj hasło – bez niego nie wydasz aktualizacji):
#      keytool -genkeypair -v -keystore edukwadrat-release.jks -alias edukwadrat -keyalg RSA -keysize 4096 -validity 10000
# 2. Przenieś edukwadrat-release.jks do folderu android/ i zrób kopię zapasową poza komputerem.
# 3. Skopiuj ten plik jako android/keystore.properties i wpisz hasła.
storeFile=edukwadrat-release.jks
storePassword=WPISZ_HASLO
keyAlias=edukwadrat
keyPassword=WPISZ_HASLO
